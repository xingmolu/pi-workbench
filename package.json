{
  "name": "pi-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Pi Desktop Electron shell",
  "main": "./out/main/index.js",
  "author": "Pi Desktop",
  "scripts": {
    "test": "vitest run --exclude 'tests/e2e/**'",
    "test:e2e": "npm run build && playwright test",
    "smoke:electron-store": "npm run build && electron scripts/electron-store-smoke.cjs",
    "smoke:pty": "electron scripts/pty-smoke.cjs",
    "rebuild:pty": "electron-rebuild --force --only node-pty --version 44.1.0 --arch arm64",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json --composite false && tsc --noEmit -p tsconfig.web.json --composite false",
    "dev:renderer": "electron-vite dev --rendererOnly",
    "start": "electron-vite preview"
  },
  "homepage": "https://github.com/xingmolu/pi-desktop",
  "dependencies": {
    "@earendil-works/pi-ai": "^0.84.4",
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@electron-toolkit/utils": "^4.0.0",
    "@hank-warren/pi-multi-login": "^0.3.2",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "electron-store": "^11.0.2",
    "jsonc-parser": "3.3.1",
    "lucide-react": "^1.38.0",
    "node-pty": "1.1.0",
    "react-diff-view": "3.3.3",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "semver": "^7.8.5",
    "typebox": "^1.3.7",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron/rebuild": "4.2.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/semver": "^7.8.0",
    "@vitejs/plugin-react": "^5.0.3",
    "electron": "44.1.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^4.0.1",
    "eslint": "^9.36.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "prettier": "^3.6.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.6",
    "vitest": "^4.1.11"
  }
}
