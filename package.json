{
  "name": "pi-desktop",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Pi Desktop Electron shell",
  "main": "./out/main/index.js",
  "author": "Pi Desktop",
  "scripts": {
    "test": "vitest run --exclude 'tests/e2e/**'",
    "test:e2e": "npm run build && playwright test",
    "smoke:electron-store": "npm run build && electron scripts/electron-store-smoke.cjs",
    "smoke:pty": "electron scripts/pty-smoke.cjs",
    "rebuild:pty": "electron-rebuild --force --only node-pty --version 44.1.0 --arch arm64",
    "predev": "npm run build:native:mac",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "check:architecture": "node scripts/check-architecture.cjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json --composite false && tsc --noEmit -p tsconfig.web.json --composite false",
    "dev:renderer": "electron-vite dev --rendererOnly",
    "prestart": "npm run build:native:mac",
    "start": "electron-vite preview",
    "demo": "node --experimental-strip-types --no-warnings scripts/demo.mjs",
    "build:native:mac": "node scripts/build-macos-computer-use-helper.cjs"
  },
  "homepage": "https://github.com/xingmolu/pi-workbench",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.285",
    "@earendil-works/pi-ai": "0.87.1",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@electron-toolkit/utils": "^4.0.0",
    "@hank-warren/pi-multi-login": "^0.3.2",
    "@modelcontextprotocol/sdk": "1.30.0",
    "diff": "9.0.0",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9",
    "jsonc-parser": "3.3.1",
    "node-pty": "1.1.0",
    "semver": "^7.8.5",
    "typebox": "^1.3.7",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron/rebuild": "4.2.0",
    "@pierre/diffs": "1.4.2",
    "@playwright/test": "^1.62.1",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/semver": "^7.8.0",
    "@vitejs/plugin-react": "^5.0.3",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "cmdk": "1.1.1",
    "electron": "44.1.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^4.0.1",
    "eslint": "^9.36.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "lucide-react": "^1.38.0",
    "prettier": "^3.6.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "4.12.4",
    "remark-gfm": "^4.0.1",
    "shiki": "4.4.3",
    "typescript": "^5.9.2",
    "vite": "^7.1.6",
    "vitest": "^4.1.11",
    "zustand": "^5.0.15"
  }
}
