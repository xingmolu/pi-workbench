{
  "schemaVersion": 1,
  "id": "works.pi.git",
  "version": "0.1.0",
  "name": "Git",
  "description": {
    "en": "Review, stage, commit and push changes in the current project, and write commit messages from the diff. Shipped with Pi Desktop.",
    "zh-CN": "查看改动、暂存、提交和推送当前项目，并根据改动生成提交信息。随 Pi Desktop 分发。"
  },
  "engines": {
    "piDesktop": ">=0.1.0"
  },
  "permissions": ["ui.view", "git.read", "git.write", "git.push", "ai.complete"],
  "contributes": {
    "views": [
      {
        "id": "changes",
        "title": {
          "zh-CN": "Git",
          "en": "Git"
        },
        "icon": "git-branch",
        "entry": "views/changes.html",
        "activation": "onProject",
        "surfaces": ["desktop", "mobile"]
      }
    ]
  }
}
