{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "electron.vite.config.*",
    "src/main/**/*",
    "src/preload/**/*",
    "src/agent-host/**/*",
    "src/terminal-host/**/*",
    "playwright.config.ts",
    "tests/e2e/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "types": [
      "electron-vite/node"
    ],
    "allowImportingTsExtensions": true
  }
}
